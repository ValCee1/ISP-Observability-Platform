{
  "title": "Sector Detail",
  "description": "Per-sector drill-down for one MikroTik PtMP sector. Pick a sector above or arrive from the Sector Fleet Overview. The Clients table lists every CPE with its raw RF figures alongside the computed alignment score, worst-first.",
  "uid": "sector-detail",
  "schemaVersion": 39,
  "version": 7,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "sector",
        "label": "Sector",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(sector_up, sector)",
        "multi": false,
        "includeAll": false,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SECTOR OVERVIEW",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status",
      "description": "Is the sector AP responding to SNMP right now.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector_up{sector=\"$sector\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "NO DATA"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Clients / capacity",
      "description": "Registered CPEs now vs this sector's warn / critical client ceiling (sector-thresholds.yml). Green = room to grow, amber = at planned capacity, red = oversubscribed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector:clients{sector=\"$sector\"})",
          "instant": true,
          "legendFormat": "clients"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 15,
                "color": "yellow"
              },
              {
                "value": 20,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Throughput now",
      "description": "Total offered load on the sector (downlink + uplink), summed from the per-CPE counters. Amber at the 20 Mbps warn line, red at the 25 Mbps critical line.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector:throughput_mbps{sector=\"$sector\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 20,
                "color": "yellow"
              },
              {
                "value": 25,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Noise Floor",
      "description": "Sector receive noise floor. A clean channel sits below -95 dBm; rising toward -80 means external interference.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector_noise_floor_dbm{sector=\"$sector\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": -90,
                "color": "yellow"
              },
              {
                "value": -80,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Worst CPE signal",
      "description": "The weakest client on the sector right now. Below -70 needs a look, below -78 is failing.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "min(sector_cpe_signal_dbm{sector=\"$sector\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": -78,
                "color": "yellow"
              },
              {
                "value": -68,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "CPU",
      "description": "Sector AP CPU load. Nv2 encryption + high packet rates drive this; sustained >85% risks forwarding delay.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector_cpu_load_percent{sector=\"$sector\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 85,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Clients vs capacity",
      "description": "Registered CPE count against the warn and critical ceilings.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(sector:clients{sector=\"$sector\"})",
          "legendFormat": "clients"
        },
        {
          "expr": "max(sector:cap_clients_warn{sector=\"$sector\"})",
          "legendFormat": "warn"
        },
        {
          "expr": "max(sector:cap_clients_crit{sector=\"$sector\"})",
          "legendFormat": "critical"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sector RF throughput vs budget",
      "description": "Downlink + uplink RF traffic, with the warn budget marked.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "targets": [
        {
          "expr": "sector:rf_downlink_bps{sector=\"$sector\"}",
          "legendFormat": "downlink"
        },
        {
          "expr": "sector:rf_uplink_bps{sector=\"$sector\"}",
          "legendFormat": "uplink"
        },
        {
          "expr": "max(sector:cap_mbps_warn{sector=\"$sector\"}) * 1e6",
          "legendFormat": "warn budget"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Noise floor",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        }
      },
      "targets": [
        {
          "expr": "sector_noise_floor_dbm{sector=\"$sector\"}",
          "legendFormat": "noise floor"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Backhaul (ether1) traffic",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "targets": [
        {
          "expr": "sector:backhaul_tx_bps{sector=\"$sector\"}",
          "legendFormat": "tx"
        },
        {
          "expr": "sector:backhaul_rx_bps{sector=\"$sector\"}",
          "legendFormat": "rx"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Sector signal trend (avg / worst / best)",
      "description": "One line each across all CPEs, instead of a line per client. If 'average' trends down, the whole sector is degrading; if only 'worst' drops, it's one CPE (check the table).",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        }
      },
      "targets": [
        {
          "expr": "avg(sector_cpe_signal_dbm{sector=\"$sector\"})",
          "legendFormat": "average"
        },
        {
          "expr": "min(sector_cpe_signal_dbm{sector=\"$sector\"})",
          "legendFormat": "worst"
        },
        {
          "expr": "max(sector_cpe_signal_dbm{sector=\"$sector\"})",
          "legendFormat": "best"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Sector SNR trend (avg / worst)",
      "description": "Average and worst SNR across all CPEs. Below ~18 dB the worst client is near the modulation floor.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "avg(sector_cpe_snr_db{sector=\"$sector\"})",
          "legendFormat": "average"
        },
        {
          "expr": "min(sector_cpe_snr_db{sector=\"$sector\"})",
          "legendFormat": "worst"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "PER-CLIENT RF",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Clients (worst alignment first)",
      "description": "Every registered CPE, worst alignment first. Signal / SNR / the two receive chains (Rx Ch0-Ch1) and their gap (Chain \u0394) are the alignment + quality picture; Drift 7d is signal vs the CPE's own 7-day average (a degrading link); Tx PHY shows rate downshift; Session is hours since it last (re)registered.",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": "Prometheus",
      "options": {
        "sortBy": [
          {
            "displayName": "Align",
            "desc": false
          }
        ],
        "cellHeight": "sm"
      },
      "targets": [
        {
          "expr": "sector:cpe:alignment_score{sector=\"$sector\"}",
          "refId": "Align",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_signal_dbm{sector=\"$sector\"}",
          "refId": "Signal",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_snr_db{sector=\"$sector\"}",
          "refId": "SNR",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_rx_strength_ch0_dbm{sector=\"$sector\"}",
          "refId": "Ch0",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_rx_strength_ch1_dbm{sector=\"$sector\"}",
          "refId": "Ch1",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector:cpe:chain_imbalance_db{sector=\"$sector\"}",
          "refId": "ChainDelta",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector:cpe:signal_drift_db{sector=\"$sector\"}",
          "refId": "Drift",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_tx_rate_bps{sector=\"$sector\"} / 1e6",
          "refId": "TxPhy",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sector_cpe_session_uptime_seconds{sector=\"$sector\"} / 360000",
          "refId": "Session",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "auth": true,
              "instance": true,
              "job": true,
              "role": true,
              "site": true,
              "sector": true,
              "cpe_mac": true,
              "wlan_ifindex": true,
              "ssid": true,
              "channel": true,
              "hrStorageDescr": true,
              "sector_cpe_ros_version": true
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "cpe_name": 0,
              "Value #Align": 1,
              "Value #Signal": 2,
              "Value #SNR": 3,
              "Value #Ch0": 4,
              "Value #Ch1": 5,
              "Value #ChainDelta": 6,
              "Value #Drift": 7,
              "Value #TxPhy": 8,
              "Value #Session": 9
            },
            "renameByName": {
              "cpe_name": "CPE",
              "Value #Align": "Align",
              "Value #Signal": "Signal (dBm)",
              "Value #SNR": "SNR (dB)",
              "Value #Ch0": "Rx Ch0",
              "Value #Ch1": "Rx Ch1",
              "Value #ChainDelta": "Chain \u0394",
              "Value #Drift": "Drift 7d",
              "Value #TxPhy": "Tx PHY (Mbps)",
              "Value #Session": "Session (h)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Align"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 40,
                      "color": "orange"
                    },
                    {
                      "value": 70,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Signal \\(dBm\\)|Rx Ch0|Rx Ch1"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": -75,
                      "color": "orange"
                    },
                    {
                      "value": -70,
                      "color": "yellow"
                    },
                    {
                      "value": -67,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chain \u0394"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 5,
                      "color": "yellow"
                    },
                    {
                      "value": 10,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SNR (dB)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 18,
                      "color": "yellow"
                    },
                    {
                      "value": 25,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Drift 7d"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": -6,
                      "color": "yellow"
                    },
                    {
                      "value": -2,
                      "color": "green"
                    },
                    {
                      "value": 6,
                      "color": "orange"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "TRAFFIC PATTERN & BUDGET",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "Busy hours - hourly averages (7d)",
      "description": "Hourly-average throughput, backhaul and client count over the last 7 days. The recurring tall points are this sector's peak period - the hours to size capacity around.",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 46
      },
      "datasource": "Prometheus",
      "timeFrom": "7d",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "clients (hourly avg)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sector:throughput_mbps:hourly{sector=\"$sector\"}",
          "legendFormat": "throughput Mbps (hourly avg)"
        },
        {
          "expr": "sector:backhaul_bps:hourly{sector=\"$sector\"} / 1e6",
          "legendFormat": "backhaul Mbps (hourly avg)"
        },
        {
          "expr": "sector:clients:hourly{sector=\"$sector\"}",
          "legendFormat": "clients (hourly avg)"
        }
      ]
    },
    {
      "id": 38,
      "type": "stat",
      "title": "Peak throughput window (7-day avg, local)",
      "description": "The local hour this sector carries the most traffic - size capacity and schedule work around it.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(1, sector:throughput_mbps:hod{sector=\"$sector\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "site": true,
              "sector": true,
              "Value": true
            }
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^hod$/"
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "00": {
                  "text": "12 AM \u2013 1 AM",
                  "index": 0
                },
                "01": {
                  "text": "1 AM \u2013 2 AM",
                  "index": 1
                },
                "02": {
                  "text": "2 AM \u2013 3 AM",
                  "index": 2
                },
                "03": {
                  "text": "3 AM \u2013 4 AM",
                  "index": 3
                },
                "04": {
                  "text": "4 AM \u2013 5 AM",
                  "index": 4
                },
                "05": {
                  "text": "5 AM \u2013 6 AM",
                  "index": 5
                },
                "06": {
                  "text": "6 AM \u2013 7 AM",
                  "index": 6
                },
                "07": {
                  "text": "7 AM \u2013 8 AM",
                  "index": 7
                },
                "08": {
                  "text": "8 AM \u2013 9 AM",
                  "index": 8
                },
                "09": {
                  "text": "9 AM \u2013 10 AM",
                  "index": 9
                },
                "10": {
                  "text": "10 AM \u2013 11 AM",
                  "index": 10
                },
                "11": {
                  "text": "11 AM \u2013 12 PM",
                  "index": 11
                },
                "12": {
                  "text": "12 PM \u2013 1 PM",
                  "index": 12
                },
                "13": {
                  "text": "1 PM \u2013 2 PM",
                  "index": 13
                },
                "14": {
                  "text": "2 PM \u2013 3 PM",
                  "index": 14
                },
