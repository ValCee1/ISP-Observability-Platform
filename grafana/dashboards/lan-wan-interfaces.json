{
    "title": "WAN/LAN Interfaces",
    "uid": "wan-lan-interfaces",
    "schemaVersion": 39,
    "version": 2,
    "editable": true,
    "timezone": "browser",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "instance",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(up{job=\"snmp-mikrotik\"}, instance)",
                "multi": true,
                "includeAll": true,
                "refresh": 2,
                "sort": 1
            },
            {
                "name": "wan",
                "type": "textbox",
                "label": "WAN / Backhaul regex",
                "current": {
                    "value": "chiemerie-ppp",
                    "text": "chiemerie-ppp"
                },
                "query": "chiemerie-ppp"
            },
            {
                "name": "lan",
                "type": "textbox",
                "label": "LAN / Core regex",
                "current": {
                    "value": "ether2|bridge.*|lan.*",
                    "text": "ether2|bridge.*|lan.*"
                },
                "query": "ether2|bridge.*|lan.*"
            },
            {
                "name": "ppp",
                "type": "textbox",
                "label": "PPP regex",
                "current": {
                    "value": ".*ppp.*",
                    "text": ".*ppp.*"
                },
                "query": ".*ppp.*"
            },
            {
                "name": "wireless",
                "type": "textbox",
                "label": "Wireless / backhaul regex",
                "current": {
                    "value": "wlan.*|backhaul.*|dish.*",
                    "text": "wlan.*|backhaul.*|dish.*"
                },
                "query": "wlan.*|backhaul.*|dish.*"
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "WAN / Backhaul",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "WAN Traffic (bps)",
            "gridPos": {
                "h": 7,
                "w": 16,
                "x": 0,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "rate(ifHCInOctets{instance=~\"$instance\", ifName=~\"$wan\"}[5m]) * 8",
                    "legendFormat": "{{instance}} - {{ifName}} in"
                },
                {
                    "expr": "rate(ifHCOutOctets{instance=~\"$instance\", ifName=~\"$wan\"}[5m]) * 8",
                    "legendFormat": "{{instance}} - {{ifName}} out"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 3,
            "type": "state-timeline",
            "title": "WAN Status",
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "ifOperStatus{instance=~\"$instance\", ifName=~\"$wan\"}",
                    "legendFormat": "{{instance}} - {{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                },
                                "2": {
                                    "text": "DOWN",
                                    "color": "red"
                                },
                                "3": {
                                    "text": "TESTING",
                                    "color": "yellow"
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 4,
            "type": "row",
            "title": "LAN / Core",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 8
            }
