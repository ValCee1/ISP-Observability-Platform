{
    "title": "PTP Link Monitoring",
    "description": "Per-link detail view for a single point-to-point radio link (SAF, AirFiber, airMAX, MikroTik). Arrive here via the NOC Overview table's row link, or pick a link from the dropdown above. Every panel is scoped to the selected link_id only.",
    "uid": "ptp-link-monitoring",
    "schemaVersion": 39,
    "version": 12,
    "editable": true,
    "timezone": "browser",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "link_id",
                "label": "Link",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(link_up, link_id)",
                "multi": false,
                "includeAll": false,
                "refresh": 2
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "LINK OVERVIEW",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Status",
            "description": "Up/down state of each radio endpoint on this link.",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 0,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_up{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "red",
                                    "index": 0
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "green",
                                    "index": 1
                                }
                            }
                        },
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "NO DATA",
                                    "color": "white",
                                    "index": 2
                                }
                            }
                        }
                    ],
                    "noValue": "NO DATA"
                }
            }
        },
        {
            "id": 20,
            "type": "gauge",
            "title": "Score",
            "description": "Composite 0-100 score blending packet loss, SNR, interface errors, and reachability (see link_health_score in prometheus/rules/link-normalization.yml). Matches the score shown on the NOC Overview table.",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 4,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_health_score{link_id=\"$link_id\"}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 60,
                                "color": "yellow"
                            },
                            {
                                "value": 85,
                                "color": "green"
                            }
                        ]
                    },
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Latency",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 8,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_latency_ms{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "ms",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 30,
                                "color": "yellow"
                            },
                            {
                                "value": 100,
                                "color": "red"
                            }
                        ]
                    },
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Loss",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 12,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_packet_loss_percent{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 2,
                                "color": "yellow"
                            },
                            {
                                "value": 10,
                                "color": "red"
                            }
                        ]
                    },
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Util %",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 16,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_utilization_percent{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 70,
                                "color": "yellow"
                            },
                            {
                                "value": 85,
                                "color": "red"
                            }
                        ]
                    },
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 10,
            "type": "stat",
            "title": "CCQ",
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 20,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_quality_percent{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 70,
                                "color": "yellow"
                            },
                            {
                                "value": 90,
                                "color": "green"
                            }
                        ]
                    },
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 8,
            "type": "row",
            "title": "SIGNAL & TRAFFIC",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 6
            }
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Signal / Noise / SNR",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 7
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_signal_dbm{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}} signal"
                },
                {
                    "expr": "link_noise_dbm{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}} noise"
                },
                {
                    "expr": "link_snr_db{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}} SNR"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "dBm"
                }
            }
        },
        {
            "id": 21,
            "type": "stat",
            "title": "Current Util",
            "description": "Current utilization = max(TX,RX) / capacity. Only available for vendors that report link capacity (SAF; AirFiber's capacity OID is currently broken on real hardware - see prometheus/rules/link-schema-notes.md. airMAX exposes no traffic-capacity data on this hardware at all).",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 12,
                "y": 7
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_utilization_percent{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 70,
                                "color": "yellow"
                            },
                            {
                                "value": 85,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 22,
            "type": "stat",
            "title": "Peak Util",
            "description": "Highest utilization observed in the selected time range.",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 16,
                "y": 7
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max_over_time(link_utilization_percent{link_id=\"$link_id\"}[$__range])",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "noValue": "N/A",
                    "mappings": [
                        {
                            "type": "special",
                            "options": {
                                "match": "null+nan",
                                "result": {
                                    "text": "N/A",
                                    "color": "white",
                                    "index": 0
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 70,
                                "color": "yellow"
                            },
                            {
                                "value": 85,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 23,
            "type": "stat",
            "title": "Capacity",
            "description": "Vendor-reported link capacity (only SAF currently exposes this reliably - see link-schema-notes.md).",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 20,
                "y": 7
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_capacity_bps{link_id=\"$link_id\"})",
                    "legendFormat": "{{link_name}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "text"
                    },
                    "unit": "bps",
                    "noValue": "N/A"
                }
            }
        },
        {
            "id": 24,
            "type": "timeseries",
            "title": "Traffic (TX/RX)",
            "gridPos": {
                "h": 4,
                "w": 12,
                "x": 12,
                "y": 11
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_tx_bps{link_id=\"$link_id\"})",
                    "legendFormat": "{{link_name}} TX"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_rx_bps{link_id=\"$link_id\"})",
                    "legendFormat": "{{link_name}} RX"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 14,
            "type": "row",
            "title": "RELIABILITY",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 15
            }
        },
        {
            "id": 25,
            "type": "timeseries",
            "title": "Latency",
            "gridPos": {
                "h": 7,
                "w": 6,
                "x": 0,
                "y": 16
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_latency_ms{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                }
            }
        },
        {
            "id": 26,
            "type": "timeseries",
            "title": "Packet Loss",
            "gridPos": {
                "h": 7,
                "w": 6,
                "x": 6,
                "y": 16
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "link_packet_loss_percent{link_id=\"$link_id\"}",
                    "legendFormat": "{{link_name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0
                }
            }
        },
        {
            "id": 15,
            "type": "timeseries",
            "title": "Interface Errors (rate/s)",
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (link_id, link_name, endpoint) (rate(link_interface_in_errors{link_id=\"$link_id\"}[5m]))",
                    "legendFormat": "{{link_name}} in"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (rate(link_interface_out_errors{link_id=\"$link_id\"}[5m]))",
                    "legendFormat": "{{link_name}} out"
                }
            ]
        },
        {
            "id": 6,
            "type": "row",
            "title": "RADIO / ENDPOINT DETAIL",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 23
            }
        },
        {
            "id": 7,
            "type": "table",
            "title": "Endpoint Snapshot",
            "description": "Current reading per radio endpoint (a/b) on this link.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 24
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_up{link_id=\"$link_id\"})",
                    "refId": "Up",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_signal_dbm{link_id=\"$link_id\"})",
                    "refId": "Signal",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_noise_dbm{link_id=\"$link_id\"})",
                    "refId": "Noise",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_quality_percent{link_id=\"$link_id\"})",
                    "refId": "Quality",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_uptime_seconds{link_id=\"$link_id\"}) / 86400",
                    "refId": "UptimeDays",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_interface_in_errors{link_id=\"$link_id\"})",
                    "refId": "InErrors",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "sum by (link_id, link_name, endpoint) (link_interface_out_errors{link_id=\"$link_id\"})",
                    "refId": "OutErrors",
                    "instant": true,
                    "format": "table"
                }
            ],
            "transformations": [
                {
                    "id": "merge",
                    "options": {}
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true,
                            "__name__": true,
                            "job": true,
                            "instance": true,
                            "auth": true,
                            "module": true,
                            "ifIndex": true,
                            "role": true,
                            "vendor": true,
                            "site": true
                        },
                        "renameByName": {
                            "Value #Up": "Status",
                            "Value #Signal": "Signal (dBm)",
                            "Value #Noise": "Noise (dBm)",
                            "Value #Quality": "Quality (%)",
                            "Value #UptimeDays": "Uptime (days)",
                            "Value #InErrors": "In Errors",
                            "Value #OutErrors": "Out Errors",
                            "link_name": "Radio",
                            "endpoint": "Endpoint",
                            "link_id": "Link"
                        }
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "custom": {
                        "cellOptions": {
                            "type": "auto"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Status"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "1": {
                                                "text": "UP",
                                                "color": "green",
                                                "index": 0
                                            },
                                            "0": {
                                                "text": "DOWN",
                                                "color": "red",
                                                "index": 1
                                            }
                                        }
                                    },
                                    {
                                        "type": "special",
                                        "options": {
                                            "match": "null+nan",
                                            "result": {
                                                "text": "NO DATA",
                                                "color": "white",
                                                "index": 2
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-background",
                                    "mode": "gradient"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 17,
            "type": "row",
            "title": "VENDOR DIAGNOSTICS (advanced)",
            "collapsed": true,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 32
            },
            "panels": [
                {
                    "id": 18,
                    "type": "timeseries",
                    "title": "SAF: MSE / FEC Error Ratio",
                    "description": "Only populated for SAF (SAF Tech / Nera) links.",
                    "gridPos": {
                        "h": 7,
                        "w": 12,
                        "x": 0,
                        "y": 33
                    },
                    "datasource": "Prometheus",
                    "targets": [
                        {
                            "expr": "link_mse_db{link_id=\"$link_id\"}",
                            "legendFormat": "{{link_name}} MSE"
                        }
                    ]
                },
                {
                    "id": 19,
                    "type": "timeseries",
                    "title": "airMAX: Quality / Capacity %",
                    "description": "Only populated for Ubiquiti airMAX links.",
                    "gridPos": {
                        "h": 7,
                        "w": 12,
                        "x": 12,
                        "y": 33
                    },
                    "datasource": "Prometheus",
                    "targets": [
                        {
                            "expr": "ubiquiti_airmax_quality_percent{link_id=\"$link_id\"}",
                            "legendFormat": "{{link_name}} quality"
                        },
                        {
                            "expr": "ubiquiti_airmax_capacity_percent{link_id=\"$link_id\"}",
                            "legendFormat": "{{link_name}} capacity"
                        }
                    ],
                    "fieldConfig": {
                        "defaults": {
                            "unit": "percent",
                            "min": 0,
                            "max": 100
                        }
                    }
                }
            ]
        }
    ],
    "annotations": {
        "list": []
    },
