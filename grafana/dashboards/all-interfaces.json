{
    "title": "MikroTik Router Detail",
    "description": "Deep-dive diagnostics for a single MikroTik router: health, storage, and per-interface traffic/status. Arrive here via the Fleet Overview table's row link, or pick a router from the dropdown above. Purpose: \"I'm investigating this router\" - for \"what needs my attention\", see MikroTik Fleet Overview.",
    "uid": "mikrotik-router-overview",
    "schemaVersion": 39,
    "version": 6,
    "editable": true,
    "timezone": "browser",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "instance",
                "label": "Router",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(up{job=\"snmp-mikrotik\"}, instance)",
                "multi": false,
                "includeAll": false,
                "refresh": 2,
                "sort": 1
            }
        ]
    },
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "HEALTH",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 1,
            "type": "stat",
            "title": "Reachability",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance) (up{job=\"snmp-mikrotik\", instance=\"$instance\"})",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "red",
                                    "index": 0
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 1,
                                "color": "green"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Uptime",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance) (sysUpTime{instance=\"$instance\"}) / 100",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "text"
                    }
                }
            }
        },
        {
            "id": 3,
            "type": "gauge",
            "title": "CPU Load",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance) (hrProcessorLoad{instance=\"$instance\"})",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 70,
                                "color": "orange"
                            },
                            {
                                "value": 90,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "type": "gauge",
            "title": "Memory Used %",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance) (100 * (hrStorageUsed{instance=\"$instance\", hrStorageDescr=~\".*[Mm]emory.*\"} / hrStorageSize{instance=\"$instance\", hrStorageDescr=~\".*[Mm]emory.*\"}))",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 75,
                                "color": "orange"
                            },
                            {
                                "value": 90,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 101,
            "type": "row",
            "title": "STORAGE & TEMPERATURE",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            }
        },
        {
            "id": 5,
            "type": "gauge",
            "title": "Disk Used %",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 6
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance, hrStorageDescr) (100 * (hrStorageUsed{instance=\"$instance\", hrStorageDescr!~\".*[Mm]emory.*\"} / hrStorageSize{instance=\"$instance\", hrStorageDescr!~\".*[Mm]emory.*\"}))",
                    "legendFormat": "{{hrStorageDescr}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 80,
                                "color": "orange"
                            },
                            {
                                "value": 95,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 103,
            "type": "gauge",
            "title": "Temperature",
            "description": "Hottest temperature sensor on the router right now. DeviceTemperatureHigh warns above 75 °C held for 15 minutes. Boards without a sensor (hAP, hEX) show 'No sensor'.",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 6,
                "y": 6
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance) (device_temperature_celsius{job=\"snmp-mikrotik\", instance=\"$instance\"})",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showThresholdMarkers": true,
                "showThresholdLabels": false
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "min": 0,
                    "max": 100,
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 60,
                                "color": "orange"
                            },
                            {
                                "value": 75,
                                "color": "red"
                            }
                        ]
                    },
                    "noValue": "No sensor"
                }
            }
        },
        {
            "id": 104,
            "type": "timeseries",
            "title": "Temperature trend",
            "description": "Every temperature sensor the router reports (e.g. CPU, board). Dashed line: 75 °C alert level.",
            "gridPos": {
                "h": 5,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "device_temperature_celsius{job=\"snmp-mikrotik\", instance=\"$instance\"}",
                    "legendFormat": "{{sensor}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "right",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "decimals": 0,
                    "noValue": "No sensor",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "transparent"
                            },
                            {
                                "value": 75,
                                "color": "red"
                            }
                        ]
                    },
                    "custom": {
                        "thresholdsStyle": {
                            "mode": "dashed"
                        },
                        "fillOpacity": 10,
                        "lineWidth": 2,
                        "axisSoftMin": 20,
                        "axisSoftMax": 80,
                        "spanNulls": 600000
                    }
                }
            }
        },
        {
            "id": 102,
            "type": "row",
            "title": "INTERFACES",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 11
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Inbound Traffic (bps)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance, ifName) (rate(ifHCInOctets{instance=\"$instance\"}[5m]) * 8)",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Outbound Traffic (bps)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance, ifName) (rate(ifHCOutOctets{instance=\"$instance\"}[5m]) * 8)",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 8,
            "type": "state-timeline",
            "title": "Interface Operational Status",
            "gridPos": {
                "h": 6,
                "w": 24,
                "x": 0,
                "y": 20
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance, ifName) (ifOperStatus{instance=\"$instance\"})",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                },
                                "2": {
                                    "text": "DOWN",
                                    "color": "red"
                                },
                                "3": {
                                    "text": "TESTING",
                                    "color": "yellow"
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 9,
            "type": "table",
            "title": "PPP Subscriber Sessions",
            "description": "One row per live PPP/PPPoE server session on this router (dynamic \"<pppoe-USER>\" interfaces from the IF-MIB). Reconnects / Session uptime / Last flap / averages are derived - RouterOS SNMP has no /ppp active table. State is DOWN for a user whose session ended in the last 2d (no uptime shown). \"Last flap\" is the most recent reconnect edge (roughly the last disconnect) and is blank when the user hasn't dropped in 2d; a true disconnect timestamp + reason has to be pushed off the router. Avg down/up are mean throughput over the current session's life. Defined in prometheus/rules/ppp-sessions.yml.",
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 26
            },
            "datasource": "Prometheus",
            "options": {
                "sortBy": [
                    {
                        "displayName": "Session uptime",
                        "desc": false
                    }
                ],
                "cellHeight": "sm",
                "footer": {
                    "show": true,
                    "reducer": [
                        "sum"
                    ],
                    "fields": [
                        "Avg ⬇ (bps)",
                        "Avg ⬆ (bps)"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "max by (user) (ppp:session:up{instance=\"$instance\"}) or 0 * max by (user) (ppp:session:start_timestamp{instance=\"$instance\"})",
                    "refId": "A",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "max by (user) (time() - ppp:session:start_timestamp{instance=\"$instance\"}) and on (user) max by (user) (ppp:session:up{instance=\"$instance\"} == 1)",
                    "refId": "C",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "max by (user) (ppp:session:last_connect_timestamp{instance=\"$instance\"} * 1000)",
                    "refId": "D",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "max by (user) (ppp:session:avg_rx_bps{instance=\"$instance\"})",
                    "refId": "E",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "max by (user) (ppp:session:avg_tx_bps{instance=\"$instance\"})",
                    "refId": "F",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "8 * max by (user) (label_replace(rate(ifHCInOctets{job=\"snmp-mikrotik\", instance=\"$instance\", ifName=~\"<(pppoe|l2tp|pptp|sstp|ovpn)-.+>\"}[5m]), \"user\", \"$1\", \"ifName\", \"<[a-z0-9]+-(.+)>\"))",
                    "refId": "G",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "8 * max by (user) (label_replace(rate(ifHCOutOctets{job=\"snmp-mikrotik\", instance=\"$instance\", ifName=~\"<(pppoe|l2tp|pptp|sstp|ovpn)-.+>\"}[5m]), \"user\", \"$1\", \"ifName\", \"<[a-z0-9]+-(.+)>\"))",
                    "refId": "H",
                    "instant": true,
                    "format": "table"
                },
                {
                    "expr": "max by (user) (ppp:session:reconnects_24h{instance=\"$instance\"})",
                    "refId": "I",
                    "instant": true,
                    "format": "table"
                }
            ],
            "transformations": [
                {
                    "id": "joinByField",
                    "options": {
                        "byField": "user",
                        "mode": "outer"
                    }
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true,
                            "__name__": true,
                            "instance": true,
                            "job": true,
                            "auth": true,
                            "site": true,
                            "role": true,
                            "ifName": true,
                            "ifIndex": true,
                            "router": true,
                            "wan_ifname": true,
                            "Time 1": true,
                            "Time 2": true,
                            "Time 3": true,
                            "Time 4": true,
                            "Time 5": true,
                            "Time 6": true,
                            "Time 7": true,
                            "Time 8": true
                        },
                        "indexByName": {
                            "user": 0,
                            "Value #A": 1,
                            "Value #I": 2,
                            "Value #C": 3,
                            "Value #D": 4,
                            "Value #G": 5,
                            "Value #H": 6,
                            "Value #E": 7,
                            "Value #F": 8
                        },
                        "renameByName": {
                            "user": "Client",
                            "Value #A": "State",
                            "Value #C": "Session uptime",
                            "Value #D": "Last flap",
                            "Value #E": "Avg ⬇ (bps)",
                            "Value #F": "Avg ⬆ (bps)",
                            "Value #G": "Now ⬇ (bps)",
                            "Value #H": "Now ⬆ (bps)",
                            "Value #I": "Reconnects 24h"
                        }
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "custom": {
                        "cellOptions": {
                            "type": "auto"
                        },
                        "align": "auto"
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "State"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "1": {
                                                "text": "UP",
                                                "color": "green",
                                                "index": 0
                                            },
                                            "0": {
                                                "text": "DOWN",
                                                "color": "red",
                                                "index": 1
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-background",
                                    "mode": "basic"
                                }
                            },
                            {
                                "id": "custom.width",
                                "value": 90
                            },
                            {
                                "id": "custom.align",
                                "value": "center"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "Last flap.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "dateTimeFromNow"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Session uptime"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "dtdurations"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "(Avg|Now) .* \\(bps\\)"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "bps"
                            },
                            {
                                "id": "decimals",
                                "value": 1
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Reconnects 24h"
                        },
                        "properties": [
                            {
                                "id": "decimals",
                                "value": 0
                            },
                            {
                                "id": "thresholds",
                                "value": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "value": null,
                                            "color": "green"
                                        },
                                        {
                                            "value": 1,
                                            "color": "yellow"
                                        },
                                        {
                                            "value": 5,
                                            "color": "red"
                                        }
                                    ]
                                }
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-text"
                                }
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "links": [
