{
    "title": "MikroTik Router Detail",
    "description": "Deep-dive diagnostics for a single MikroTik router: health, storage, and per-interface traffic/status. Arrive here via the Fleet Overview table's row link, or pick a router from the dropdown above. Purpose: \"I'm investigating this router\" - for \"what needs my attention\", see MikroTik Fleet Overview.",
    "uid": "mikrotik-router-overview",
    "schemaVersion": 39,
    "version": 4,
    "editable": true,
    "timezone": "browser",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "instance",
                "label": "Router",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(up{job=\"snmp-mikrotik\"}, instance)",
                "multi": false,
                "includeAll": false,
                "refresh": 2,
                "sort": 1
            }
        ]
    },
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "HEALTH",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 1,
            "type": "stat",
            "title": "Reachability",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance) (up{job=\"snmp-mikrotik\", instance=\"$instance\"})",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "red",
                                    "index": 0
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 1,
                                "color": "green"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Uptime",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance) (sysUpTime{instance=\"$instance\"}) / 100",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "text"
                    }
                }
            }
        },
        {
            "id": 3,
            "type": "gauge",
            "title": "CPU Load",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance) (hrProcessorLoad{instance=\"$instance\"})",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 70,
                                "color": "orange"
                            },
                            {
                                "value": 90,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "type": "gauge",
            "title": "Memory Used %",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance) (100 * (hrStorageUsed{instance=\"$instance\", hrStorageDescr=~\".*[Mm]emory.*\"} / hrStorageSize{instance=\"$instance\", hrStorageDescr=~\".*[Mm]emory.*\"}))",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 75,
                                "color": "orange"
                            },
                            {
                                "value": 90,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 101,
            "type": "row",
            "title": "STORAGE",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            }
        },
        {
            "id": 5,
            "type": "gauge",
            "title": "Disk Used %",
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance, hrStorageDescr) (100 * (hrStorageUsed{instance=\"$instance\", hrStorageDescr!~\".*[Mm]emory.*\"} / hrStorageSize{instance=\"$instance\", hrStorageDescr!~\".*[Mm]emory.*\"}))",
                    "legendFormat": "{{hrStorageDescr}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 80,
                                "color": "orange"
                            },
                            {
                                "value": 95,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 102,
            "type": "row",
            "title": "INTERFACES",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 10
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Inbound Traffic (bps)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 11
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance, ifName) (rate(ifHCInOctets{instance=\"$instance\"}[5m]) * 8)",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Outbound Traffic (bps)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 11
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (instance, ifName) (rate(ifHCOutOctets{instance=\"$instance\"}[5m]) * 8)",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bps"
                }
            }
        },
        {
            "id": 8,
            "type": "state-timeline",
            "title": "Interface Operational Status",
            "gridPos": {
                "h": 6,
                "w": 24,
                "x": 0,
                "y": 19
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "max by (instance, ifName) (ifOperStatus{instance=\"$instance\"})",
                    "legendFormat": "{{ifName}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                },
                                "2": {
                                    "text": "DOWN",
                                    "color": "red"
                                },
                                "3": {
                                    "text": "TESTING",
                                    "color": "yellow"
                                }
                            }
                        }
                    ]
                }
            }
        }
    ]
}
