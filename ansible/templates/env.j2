# Written by Ansible from ansible/secrets.yml - edit there, not here.
# Compose reads COMPOSE_PROJECT_NAME from this file, so manual
# `docker compose ...` in this folder uses the same project (and volumes).
COMPOSE_PROJECT_NAME={{ compose_project }}
WHATSAPP_MODE={{ whatsapp_mode }}
WHATSAPP_PHONE_NUMBER_ID={{ whatsapp_phone_number_id }}
WHATSAPP_RECIPIENTS={{ whatsapp_recipients }}
WHATSAPP_TEMPLATE={{ whatsapp_template }}
WHATSAPP_DAILY_CAP={{ whatsapp_daily_cap }}
WHATSAPP_MONTHLY_CAP={{ whatsapp_monthly_cap }}
