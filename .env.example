# Copy to .env (gitignored) and fill in. Every value is optional: with none
# set the stack runs and WhatsApp stays in dry-run (nothing is ever sent).
# Details: docs/whatsapp.md, docs/SETUP-INPUTS.md

# dry_run = log only, no messages, no cost.  live = really send via Meta.
WHATSAPP_MODE=dry_run

# From Meta: WhatsApp > API Setup > "Phone number ID" (NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# Who gets critical alerts. International format, digits only, no '+',
# comma-separated. Each extra number multiplies cost - start with one.
WHATSAPP_RECIPIENTS=

# Name of the approved Utility template (body: "ISP alert: {{1}}. {{2}}").
WHATSAPP_TEMPLATE=isp_critical_alert

# Hard spending limits, counted per message (per recipient).
WHATSAPP_DAILY_CAP=10
WHATSAPP_MONTHLY_CAP=100
