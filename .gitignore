# Ansible: per-ISP data lives in each ISP's own site repo (--site), never
# here. Only the fictional example site is committed. The old single-site
# files are ignored so a leftover copy cannot be committed by accident.
inventories/*
!inventories/example/
ansible/inventory.ini
ansible/secrets.yml
